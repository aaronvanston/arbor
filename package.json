{
  "name": "arbor",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "build:release": "tsc && vite build --sourcemap hidden && bun scripts/posthog-sourcemaps.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "oxlint --disable-nested-config",
    "knip": "knip",
    "test": "bun test",
    "verify": "bun run typecheck && bun run typecheck:tests && bun run lint && bun run knip && bun run test",
    "verify:rust": "cd src-tauri && cargo test && cargo test --manifest-path ../core-plugins/arbor-models/Cargo.toml",
    "bindings": "cd src-tauri && ARBOR_WRITE_BINDINGS=1 cargo test --quiet bindings::",
    "notices": "bun scripts/third-party-notices.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@pierre/diffs": "^1.5.1",
    "@pierre/trees": "1.0.0-beta.6",
    "@tanstack/react-table": "^9.2.4",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-notification": "^2",
    "class-variance-authority": "^0.7.1",
    "diff": "^9.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.0.0",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "knip": "^6.38.0",
    "oxlint": "^1.85.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "optionalDependencies": {
    "@hugeicons-pro/core-duotone-rounded": "^4.3.4"
  }
}
